# Frontend build-time environment.
#
# Copy to .env.local for local overrides. Values here are inlined into the
# browser bundle at build time, so nothing secret belongs in this file.
#
# Leave VITE_API_BASE_URL unset in development: vite.config.ts proxies "/api"
# to 127.0.0.1:8000, which keeps the browser on one origin and needs no CORS.
#
# Set it in production, where the frontend and backend are different hosts.
# The value must include the "/api" path and no trailing slash.
VITE_API_BASE_URL=https://nodus-0qo0.onrender.com/api
